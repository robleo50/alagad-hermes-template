+    def _drop_post_send_narration(self, messages: List[Dict]) -> None:
+        """Drop ONLY a trailing bare assistant turn flagged as post-successful-send
+        narration (Alagad Fix A). Keeps the tool_call + tool result intact -- no
+        rewind. The four-condition gate is enforced at flag time in conversation_loop
+        (the no-tool-call final-response branch)."""
+        if (
+            messages
+            and isinstance(messages[-1], dict)
+            and messages[-1].get("_post_send_narration_drop")
+            and messages[-1].get("role") == "assistant"
+            and not messages[-1].get("tool_calls")
+        ):
+            messages.pop()
